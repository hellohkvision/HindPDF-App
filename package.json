{
  "name": "hindpdf-mobile",
  "version": "1.0.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "engine": "node scripts/build-engine.mjs",
    "test": "node --test tests/*.test.cjs",
    "verify": "npm run typecheck && npm test && npm run engine",
    "prestart": "npm run engine",
    "preandroid": "npm run engine",
    "preios": "npm run engine",
    "prebuild:android": "npm run engine && expo prebuild --platform android"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "expo-dev-client": "~6.0.0",
    "expo-document-picker": "~14.0.0",
    "expo-file-system": "~19.0.0",
    "expo-image-picker": "~17.0.0",
    "expo-print": "~15.0.0",
    "expo-sharing": "~14.0.0",
    "expo-crypto": "~15.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-auth-session": "~7.0.0",
    "expo-web-browser": "~15.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-webview": "13.15.0",
    "react-native-pdf": "6.7.7",
    "react-native-blob-util": "0.22.2",
    "react-native-svg": "15.12.1",
    "firebase": "^12.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "3.11.174",
    "jspdf": "3.0.4",
    "jszip": "3.10.1",
    "react-native-razorpay": "2.3.1",
    "@expo/vector-icons": "^15.0.0",
    "expo-camera": "~17.0.0",
    "expo-font": "14.0.12",
    "@expo-google-fonts/montserrat": "^0.4.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2",
    "esbuild": "^0.25.0"
  }
}
