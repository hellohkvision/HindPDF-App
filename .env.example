EXPO_PUBLIC_API_BASE=https://api.hindpdf.com
# OAuth requires registered Android/iOS clients and a development build.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Enable existing Razorpay checkout only in an approved distribution build.
EXPO_PUBLIC_ENABLE_RAZORPAY=false
