EXPO_PUBLIC_API_BASE=https://api.hindpdf.com
# Optional overrides for native Google sign-in; see README for Firebase and signing setup.
# The app defaults to the HindPDF website's public web OAuth client ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Required only to enable Google sign-in in an iOS build.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Enable existing Razorpay checkout only in an approved distribution build.
EXPO_PUBLIC_ENABLE_RAZORPAY=false
